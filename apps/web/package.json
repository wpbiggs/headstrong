{
  "name": "@headstrong/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cloudflare": "vite build",
    "dev:cloudflare": "vite dev --host 127.0.0.1",
    "types:cloudflare": "wrangler types cloudflare/env.d.ts --strict-vars false",
    "typecheck:cloudflare": "pnpm types:cloudflare && tsc -p tsconfig.cloudflare.json",
    "dev:vinext:fixture": "vite --config vite.fixture.config.ts --host 127.0.0.1 --port 3000 --strictPort",
    "check:cloudflare": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@headstrong/core": "workspace:*",
    "@headstrong/moderation": "workspace:*",
    "@headstrong/scene-planner": "workspace:*",
    "next": "16.4.1",
    "playcanvas": "2.23.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-rsc": "^0.5.37",
    "jose": "^5.9.6",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.2.0",
    "vite": "^8",
    "wrangler": "^4.151.0"
  }
}
