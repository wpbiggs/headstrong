{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "headstrong-preview-web",
  "main": "cloudflare/entry.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "services": [{ "binding": "API", "service": "headstrong-preview-api" }],
  "vars": {
    "PREVIEW_SYNTHETIC_DATA_ONLY": "false",
    "ACCESS_ISSUER": "https://replace-me.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "replace-me"
  },
  "ratelimits": [
    {
      "name": "EDGE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
