{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/worker-env.d.ts",
      "apps/web/cloudflare/env.d.ts",
      ".agents/**",
      "**/.wrangler/**",
      "artifacts/local-verification/**",
      ".turbo/**",
      "**/.turbo/**",
      ".next/**",
      "dist/**",
      "test-results/**",
      "playwright-report/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
