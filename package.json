{
  "name": "headstrong",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": { "node": ">=22.12.0" },
  "pnpm": {
    "overrides": {
      "fflate@0.7.3": "0.7.5",
      "undici@7.29.1": "7.30.1",
      "fast-uri@3.1.8": "3.1.9",
      "follow-redirects@1.16.1": "1.16.2"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:cloudflare": "node scripts/verify-local.mjs --cloudflare",
    "format": "biome format --write .",
    "db:migrate": "pnpm --filter @headstrong/api migrate",
    "test:learning:browser": "playwright test --config tests/learning/playwright.config.ts",
    "test:awakening": "pnpm --filter @headstrong/api exec node --import tsx --test ../web/lib/awakening.test.ts",
    "test": "pnpm --filter @headstrong/api test && pnpm --filter @headstrong/integration-lti test && pnpm --filter @headstrong/integration-rostering test && pnpm --filter @headstrong/integration-google-classroom test && pnpm --filter @headstrong/integration-open-badges test && pnpm test:awakening"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.64.1",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  }
}
